rules_version = '2';

// Deploy with Firebase Auth setup. This authorizes all client SDK/REST writes.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
          && request.auth.token.admin == true
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function previousStatus(data) {
      return data.get('status', 'unknown') in ['safe', 'advisory', 'unconfirmed'] ? data.status : 'unknown';
    }
    function validReviewNote(data) {
      return data.get('reviewNote', '') is string && data.get('reviewNote', '').size() <= 500;
    }
    function pairedZoneChange(zoneId) {
      let id = request.resource.data.lastChangeId;
      let change = getAfter(/databases/$(database)/documents/datasets/community-v1/zoneChanges/$(id)).data;
      return id is string && id.matches('^[a-zA-Z0-9_-]{1,100}$')
          && !exists(/databases/$(database)/documents/datasets/community-v1/zoneChanges/$(id))
          && change.zoneId == zoneId && change.fromStatus == previousStatus(resource.data)
          && change.toStatus == request.resource.data.status && change.changedAt == request.time;
    }
    // Live clients use a clean dataset. Legacy root collections stay intact;
    // their historical demo flags and reports are never copied into this feed.
    match /datasets/community-v1/zones/{zoneId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdated', 'lastChangeId'])
          && request.resource.data.status in ['safe', 'advisory', 'unconfirmed']
          && request.resource.data.status != previousStatus(resource.data)
          && request.resource.data.lastUpdated == request.time
          && pairedZoneChange(zoneId);
    }
    match /datasets/community-v1/reports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['zoneId', 'description', 'photoUrl', 'status', 'submittedAt'])
          && request.resource.data.keys().hasOnly(['zoneId', 'description', 'photoUrl', 'status', 'submittedAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 10
          && request.resource.data.description.size() <= 2000
          && request.resource.data.zoneId is string
          && exists(/databases/$(database)/documents/datasets/community-v1/zones/$(request.resource.data.zoneId))
          && (request.resource.data.photoUrl == null || (request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() <= 2048
              && request.resource.data.photoUrl.matches('https://.*')))
          && request.resource.data.submittedAt == request.time;
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewNote'])
          && request.resource.data.status in ['pending', 'confirmed', 'rejected']
          && validReviewNote(request.resource.data)
          && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /datasets/community-v1/zoneChanges/{changeId} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if isAdmin()
          && request.resource.data.keys().hasAll(['zoneId', 'fromStatus', 'toStatus', 'note', 'reportId', 'changedAt'])
          && request.resource.data.keys().hasOnly(['zoneId', 'fromStatus', 'toStatus', 'note', 'reportId', 'changedAt'])
          && request.resource.data.zoneId is string
          && request.resource.data.zoneId.matches('^[a-zA-Z0-9_-]{1,100}$')
          && request.resource.data.fromStatus == previousStatus(get(/databases/$(database)/documents/datasets/community-v1/zones/$(request.resource.data.zoneId)).data)
          && request.resource.data.toStatus in ['safe', 'advisory', 'unconfirmed']
          && request.resource.data.fromStatus != request.resource.data.toStatus
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && request.resource.data.changedAt == request.time
          && (request.resource.data.reportId == null || (request.resource.data.reportId is string
              && request.resource.data.reportId.size() <= 200
              && get(/databases/$(database)/documents/datasets/community-v1/reports/$(request.resource.data.reportId)).data.zoneId == request.resource.data.zoneId
              && get(/databases/$(database)/documents/datasets/community-v1/reports/$(request.resource.data.reportId)).data.status == 'confirmed'))
          && getAfter(/databases/$(database)/documents/datasets/community-v1/zones/$(request.resource.data.zoneId)).data.status == request.resource.data.toStatus
          && getAfter(/databases/$(database)/documents/datasets/community-v1/zones/$(request.resource.data.zoneId)).data.lastChangeId == changeId
          && getAfter(/databases/$(database)/documents/datasets/community-v1/zones/$(request.resource.data.zoneId)).data.lastUpdated == request.time;
    }
    match /zones/{zoneId} {
      allow read: if true;
      // Zone geometry/creation requires trusted provisioning, never public writes.
      allow create, delete: if false;
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdated'])
          && request.resource.data.status in ['safe', 'advisory', 'unconfirmed']
          && request.resource.data.lastUpdated == request.time;
    }
    match /reports/{reportId} {
      // Public map/pending counts consume this collection. Reports are still
      // public; privacy and abuse/rate limiting require separate changes.
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['zoneId', 'description', 'photoUrl', 'status', 'submittedAt'])
          && request.resource.data.keys().hasOnly(['zoneId', 'description', 'photoUrl', 'status', 'submittedAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 10
          && request.resource.data.description.size() <= 2000
          && request.resource.data.zoneId is string
          && exists(/databases/$(database)/documents/zones/$(request.resource.data.zoneId))
          && (request.resource.data.photoUrl == null || (request.resource.data.photoUrl is string
              && request.resource.data.photoUrl.size() <= 2048
              && request.resource.data.photoUrl.matches('https://.*')))
          && request.resource.data.submittedAt == request.time;
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
          && request.resource.data.status in ['pending', 'confirmed', 'rejected']
          && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    // No client may grant claims or write arbitrary collections.
  }
}
